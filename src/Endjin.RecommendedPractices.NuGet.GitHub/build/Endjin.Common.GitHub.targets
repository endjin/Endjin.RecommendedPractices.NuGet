<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!--
        These properties would normally be set during the MSBuild evaluation phase, so you'd
        expect them to go in a .props file. However, we're using a Task to retrieve the
        GitHub repo details, and you can only run tasks in a Target. So we have to
        set all these NuGet properties during the Target execution phase. We make this
        run before Compile because the Compile Target runs some code generation tasks
        that will in some circumstances attempt to use some of these properties. It also
        runs before GenerateNuspec, because Compile doesn't run in every pack: not when
        "dotnet pack" is given the no-build option, and not in the outer build of a project
        that targets multiple frameworks, which is where the package is created.

        Although this is the GitHub-specific package, the basic Endjin.RecommendedPractices
        detects the presence of a Git repo and determines the org and project names as
        part of that, so this target depends on the EndjinDetectGitHub target from that
        package and uses its outputs to set the relevant NuGet package properties.
    -->
    <Target Name="_EndjinSetGitHubProperties" BeforeTargets="Compile;GenerateNuspec" DependsOnTargets="EndjinDetectGitHub">
        <!--
            Source Link for GitHub comes from the .NET SDK's built-in support, not from a package
            dependency. MicrosoftBuildTasksGitAssemblyFile is set by the SDK's Source Link support,
            or by a Microsoft.SourceLink.* package if the project references one. It is empty when
            the project sets SuppressImplicitGitSourceLink to true without referencing a package.
        -->
        <Warning
            Condition="'$(MicrosoftBuildTasksGitAssemblyFile)' == ''"
            Text="Endjin.RecommendedPractices.GitHub relies on the Source Link support built into the .NET SDK, but Source Link is not available in this build. Remove the SuppressImplicitGitSourceLink setting, or add a PackageReference to Microsoft.SourceLink.GitHub."
            />

        <!--
            These are defaults: a value the project has already set (e.g. in its csproj) wins. An
            empty element, such as <PackageReleaseNotes></PackageReleaseNotes>, counts as not set.
        -->
        <PropertyGroup Condition="'$(EndjinProjectIsInGitHubRepo)' == 'true'">
            <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/$(EndjinGitHubOrg)/$(EndjinGitHubProject).git</RepositoryUrl>
            <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/$(EndjinGitHubOrg)/$(EndjinGitHubProject)</PackageProjectUrl>
            <PackageReleaseNotes Condition="'$(PackageReleaseNotes)' == ''">See https://github.com/$(EndjinGitHubOrg)/$(EndjinGitHubProject)/releases/</PackageReleaseNotes>
        </PropertyGroup>
    </Target>

</Project>