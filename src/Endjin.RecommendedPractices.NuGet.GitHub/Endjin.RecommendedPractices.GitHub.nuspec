<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">

    <metadata>
        <id>Endjin.RecommendedPractices.GitHub</id>

        <!-- This is overridden by the automatic build. It is present here to avoid validation failures. -->
        <version>0.3.0</version>
        <description>Applies endjin standard practices to a .NET project hosted in GitHub.</description>
        <authors>endjin</authors>
        <icon>images\EndjinIcon.png</icon>

        <developmentDependency>true</developmentDependency>
        <!--
        No dependency on Microsoft.SourceLink.GitHub: the .NET SDK has Source Link for GitHub
        built in, matched to the SDK version in use. Referencing the package would switch that
        off and tie every consumer to the MSBuild version the package was built for.
        Endjin.Common.GitHub.targets warns if Source Link is unavailable. Projects that need a
        specific Source Link version can still add their own PackageReference to
        Microsoft.SourceLink.GitHub.
        -->
        <dependencies>
            <dependency id="Endjin.RecommendedPractices" version="$version$" />
        </dependencies>
    </metadata>

    <files>
        <file src="..\images\**" target="images" />
        <file src="build\**" target="build" />
        <file src="build\**" target="buildMultiTargeting" />
    </files>
</package>