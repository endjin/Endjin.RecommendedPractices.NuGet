<Project ToolsVersion="14.0" 
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!--
        We set up code analysis to use a solution-level .editorconfig file. There's no built-in way
        for a NuGet package to supply solution-level content so we just check to see if the
        relevant files exist, and if not, create them.

        The files are only copied during a build, and the .NET SDK decides which of them apply to
        a compilation before that. So until they exist, Endjin.Common.Net.props supplies the same
        settings from the package itself: its copy of stylecop.json, and the C# settings of the
        default .editorconfig as a global analyzer config (Endjin.CodeAnalysis.globalconfig).

        The automatic copying of stylecop.json can be disabled with:

        <EndjinDisableCodeAnalysis>true</EndjinDisableCodeAnalysis>

        which also removes the StyleCop.Analyzers, Roslynator.Analyzers and
        Microsoft.VisualStudio.Threading.Analyzers analyzers from compilation (see
        _EndjinRemoveCodeAnalysisAnalyzers below). The .editorconfig (and the
        global analyzer config) can be turned off with:

        <EndjinDisableCreateEditorConfig>true</EndjinDisableCreateEditorConfig>

        The copies are a convenience, so that the settings are visible and easy to change. The
        build doesn't depend on them: the package supplies the same stylecop.json settings, C#
        .editorconfig settings and package icon itself (see Endjin.Common.Net.props and
        _EndjinIncludePackageIcon below). So a solution that doesn't want a NuGet package writing
        files into its solution folder can turn off all three copies, and keep the settings,
        with:

        <EndjinDisableSolutionLevelFiles>true</EndjinDisableSolutionLevelFiles>

        See docs/adr/0006-solution-level-files-are-optional.md.
    -->
    <Target Name="_EndjinEnsureCodeAnalysisRuleSet" AfterTargets="BeforeBuild" BeforeTargets="CoreBuild">
        <Copy Condition="($(EndjinDisableCodeAnalysis) != 'true') and ($(EndjinDisableSolutionLevelFiles) != 'true') and (!Exists('$(SolutionDir)stylecop.json'))" SourceFiles="$(MSBuildThisFileDirectory)stylecop.json" DestinationFiles="$(SolutionDir)stylecop.json" />
    </Target>

    <!--
        The package ships the default as default.editorconfig, not .editorconfig, because
        "dotnet pack" always leaves out files whose names start with a dot. It is copied to
        the solution folder under its real name.
    -->
    <Target Name="_EndjinEnsureEditorConfig" AfterTargets="BeforeBuild" BeforeTargets="CoreBuild">
        <Copy Condition="($(EndjinDisableCreateEditorConfig) != 'true') and ($(EndjinDisableSolutionLevelFiles) != 'true') and (!Exists('$(SolutionDir).editorconfig'))" SourceFiles="$(MSBuildThisFileDirectory)default.editorconfig" DestinationFiles="$(SolutionDir).editorconfig" />
    </Target>

    <!--
        If the solution doesn't already have a package icon, we supply a default one so that
        developers don't see a big red cross against a non-existent file as their first experience
        after adding this package.
    -->
    <Target Name="_EndjinEnsureSolutionLevelPackageIcon" AfterTargets="BeforeBuild" BeforeTargets="CoreBuild">
        <Copy Condition="($(IsPackable) != 'false') and ($(EndjinDisableDefaultPackageIconInclusion) != 'true') and ($(EndjinDisableSolutionLevelFiles) != 'true') and (!Exists('$(SolutionDir)PackageIcon.png'))" SourceFiles="$(MSBuildThisFileDirectory)DefaultPackageIcon.png" DestinationFiles="$(SolutionDir)PackageIcon.png" />
    </Target>

    <!--
        Endjin.Common.NuGet.props uses the solution's PackageIcon.png if it exists when the project
        is loaded. It doesn't exist yet on the first build of a clean checkout that doesn't commit it
        (the copy above happens during the build), or ever when EndjinDisableSolutionLevelFiles is
        true. Without this target, those packages would silently have no icon. So when packing, if
        no icon has been set, we use the solution's PackageIcon.png if it now exists, and otherwise
        the package's default icon.
    -->
    <Target
        Name="_EndjinIncludePackageIcon"
        BeforeTargets="_GetPackageFiles;GenerateNuspec"
        Condition="('$(IsPackable)' != 'false') and ('$(EndjinDisableDefaultPackageIconInclusion)' != 'true') and ('$(PackageIcon)' == '')">
        <PropertyGroup>
            <_EndjinPackageIconFile Condition="Exists('$(SolutionDir)PackageIcon.png')">$(SolutionDir)PackageIcon.png</_EndjinPackageIconFile>
            <_EndjinPackageIconFile Condition="'$(_EndjinPackageIconFile)' == ''">$(MSBuildThisFileDirectory)DefaultPackageIcon.png</_EndjinPackageIconFile>
            <PackageIcon>PackageIcon.png</PackageIcon>
        </PropertyGroup>
        <ItemGroup>
            <None Include="$(_EndjinPackageIconFile)" Link="PackageIcon.png" Pack="true" PackagePath="PackageIcon.png" />
        </ItemGroup>
    </Target>

    <!--
        Documentation templates. A project that sets

        <EndjinCreateDocumentationTemplates>true</EndjinCreateDocumentationTemplates>

        gets the files under templates/ in this package copied into its repository, at the same
        relative paths (for example docs/releasing/Releasing.md, a procedure for releasing and for
        withdrawing a bad release, and docs/adr/0000-adr-template.md). They go in the root of the
        Git repository the project is in, or in the solution folder if it isn't in one. As with
        .editorconfig, a file that already exists is never overwritten, so the copies are yours to
        edit. This is off by default: unlike the code analysis settings, documentation isn't
        something every project needs.
    -->
    <Target
        Name="_EndjinCreateDocumentationTemplates"
        AfterTargets="BeforeBuild"
        BeforeTargets="CoreBuild"
        DependsOnTargets="EndjinDetectGitHub"
        Condition="'$(EndjinCreateDocumentationTemplates)' == 'true'">
        <PropertyGroup>
            <_EndjinDocumentationRoot>$(EndjinRepositoryRoot)</_EndjinDocumentationRoot>
            <_EndjinDocumentationRoot Condition="'$(_EndjinDocumentationRoot)' == ''">$(SolutionDir)</_EndjinDocumentationRoot>
        </PropertyGroup>
        <ItemGroup>
            <_EndjinDocumentationTemplate Include="$(MSBuildThisFileDirectory)templates\**\*" />
            <_EndjinDocumentationTemplate>
                <Destination>$(_EndjinDocumentationRoot)%(RecursiveDir)%(Filename)%(Extension)</Destination>
            </_EndjinDocumentationTemplate>
        </ItemGroup>
        <Copy
            SourceFiles="@(_EndjinDocumentationTemplate)"
            DestinationFiles="%(_EndjinDocumentationTemplate.Destination)"
            Condition="!Exists('%(_EndjinDocumentationTemplate.Destination)')" />
    </Target>

    <!--
        Non-packable projects will not be distributed through NuGet and so in general we don't
        require all public elements to be documented, so we disable SA1600 (StyleCop) and CS1591
        (the compiler's own missing-XML-comment warning, which GenerateDocumentationFile turns on
        for every project). Projects that want to keep these can opt out with this setting:

        <EndjinLeaveWarningsEnabledOnNonPackableProject>true</EndjinLeaveWarningsEnabledOnNonPackableProject>
    -->
    <PropertyGroup Condition="($(IsPackable) == 'false') and ($(EndjinLeaveWarningsEnabledOnNonPackableProject) != 'true')">
        <NoWarn>$(NoWarn);SA1600;CS1591</NoWarn>
    </PropertyGroup>

    <!--
        Endjin.Common.Net.props makes warnings errors in Release builds when the configuration is
        passed in (dotnet build -c Release, Visual Studio, dotnet pack). A project can also choose
        its configuration in its own file, which is only evaluated after our .props, so we check
        again here, where the final configuration is known. Our .props leaves exactly "False"
        (capital F) when it couldn't decide; the ordinal comparison below tells that apart from a
        value the project set itself (such as "false"), which is kept.
    -->
    <PropertyGroup Condition="$(TreatWarningsAsErrors.Equals('False')) And '$(Configuration)' == 'Release'">
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!--
        Ensure that if anyone adds a local.settings.json, it will get copied to the output folder
        without needing to manually configure it in Solution Explorer. (We don't want to have to
        configure them directly in the .csproj via Solution Explorer  because these local settings
        files don't get checked in, so not everyone has them. So you'd end up with project files
        specifying options for files that aren't actually there, causing Solution Explorer to show
        an entry for the file with a red icon indicating a problem.)

        This is in the .targets file so that it can run after all items have been defined.
    -->
    <ItemGroup>
        <None Update="local.settings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!--
        StyleCop.Analyzers, Roslynator.Analyzers and Microsoft.VisualStudio.Threading.Analyzers come
        in as dependencies of this package (see the nuspec), so they can't be left out of restore
        conditionally. Instead, when
        EndjinDisableCodeAnalysis is true, we remove their analyzers after NuGet has resolved
        them. ResolveLockFileAnalyzers also runs in Visual Studio design-time builds, so the
        IDE respects the setting too.
    -->
    <Target Name="_EndjinRemoveCodeAnalysisAnalyzers" AfterTargets="ResolveLockFileAnalyzers" Condition="'$(EndjinDisableCodeAnalysis)' == 'true'">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'StyleCop.Analyzers' Or '%(Analyzer.NuGetPackageId)' == 'Roslynator.Analyzers' Or '%(Analyzer.NuGetPackageId)' == 'Microsoft.VisualStudio.Threading.Analyzers'" />
        </ItemGroup>
    </Target>

    <!--
        This package and its analyzer dependencies are for building the consuming project only.
        NuGet tooling adds development dependencies with PrivateAssets="all", which stops them
        flowing into packages that the consuming project produces. A hand-written reference
        without it would make the produced package depend on Endjin.RecommendedPractices (and,
        through it, the analyzers), so we fail the pack in that case.
    -->
    <Target Name="_EndjinVerifyPrivateAssets" BeforeTargets="GenerateNuspec">
        <ItemGroup>
            <_EndjinNonPrivateReference
                Include="@(PackageReference)"
                Condition="('%(PackageReference.Identity)' == 'Endjin.RecommendedPractices' Or '%(PackageReference.Identity)' == 'Endjin.RecommendedPractices.GitHub') And '%(PackageReference.PrivateAssets)' != 'all'" />
        </ItemGroup>
        <Error
            Condition="'@(_EndjinNonPrivateReference)' != ''"
            Text="The PackageReference to %(_EndjinNonPrivateReference.Identity) must set PrivateAssets to all, or the package this project produces will depend on it. Change the reference to: &lt;PackageReference Include=&quot;%(_EndjinNonPrivateReference.Identity)&quot; Version=&quot;...&quot; PrivateAssets=&quot;all&quot; /&gt;"
            />
    </Target>
</Project>