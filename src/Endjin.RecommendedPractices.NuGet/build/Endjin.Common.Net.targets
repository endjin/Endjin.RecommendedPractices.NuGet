<Project ToolsVersion="14.0" 
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!--
        We set up code analysis to use a solution-level .editorconfig file. There's no built-in way
        for a NuGet package to supply solution-level content so we just check to see if the
        relevant files exist, and if not, create them.

        The files are only copied during a build, and the .NET SDK decides which of them apply to
        a compilation before that. So until they exist, Endjin.Common.Net.props supplies the same
        settings from the package itself: its copy of stylecop.json, and the C# settings of the
        default .editorconfig as a global analyzer config (Endjin.CodeAnalysis.globalconfig).

        The automatic copying of stylecop.json can be disabled with:

        <EndjinDisableCodeAnalysis>true</EndjinDisableCodeAnalysis>

        which also removes the StyleCop.Analyzers and Roslynator.Analyzers analyzers from
        compilation (see _EndjinRemoveCodeAnalysisAnalyzers below). The .editorconfig (and the
        global analyzer config) can be turned off with:

        <EndjinDisableCreateEditorConfig>true</EndjinDisableCreateEditorConfig>
    -->
    <Target Name="_EndjinEnsureCodeAnalysisRuleSet" AfterTargets="BeforeBuild" BeforeTargets="CoreBuild">
        <Copy Condition="($(EndjinDisableCodeAnalysis) != 'true') and (!Exists('$(SolutionDir)stylecop.json'))" SourceFiles="$(MSBuildThisFileDirectory)stylecop.json" DestinationFiles="$(SolutionDir)stylecop.json" />
    </Target>

    <!--
        The package ships the default as default.editorconfig, not .editorconfig, because
        "dotnet pack" always leaves out files whose names start with a dot. It is copied to
        the solution folder under its real name.
    -->
    <Target Name="_EndjinEnsureEditorConfig" AfterTargets="BeforeBuild" BeforeTargets="CoreBuild">
        <Copy Condition="($(EndjinDisableCreateEditorConfig) != 'true') and (!Exists('$(SolutionDir).editorconfig'))" SourceFiles="$(MSBuildThisFileDirectory)default.editorconfig" DestinationFiles="$(SolutionDir).editorconfig" />
    </Target>

    <!--
        If the solution doesn't already have a package icon, we supply a default one so that
        developers don't see a big red cross against a non-existent file as their first experience
        after adding this package.
    -->
    <Target Name="_EndjinEnsureSolutionLevelPackageIcon" AfterTargets="BeforeBuild" BeforeTargets="CoreBuild">
        <Copy Condition="($(IsPackable) != 'false') and ($(EndjinDisableDefaultPackageIconInclusion) != 'true') and (!Exists('$(SolutionDir)PackageIcon.png'))" SourceFiles="$(MSBuildThisFileDirectory)/DefaultPackageIcon.png" DestinationFiles="$(SolutionDir)PackageIcon.png" />
    </Target>

    <!--
        Non-packable projects will not be distributed through NuGet and so in general we don't
        require all public elements to be documented, so we disable SA1600. Projects that want
        to keep this can opt out with this setting:

        <EndjinLeaveWarningsEnabledOnNonPackableProject>true</EndjinLeaveWarningsEnabledOnNonPackableProject>
    -->
    <PropertyGroup Condition="($(IsPackable) == 'false') and ($(EndjinLeaveWarningsEnabledOnNonPackableProject) != 'true')">
        <NoWarn>$(NoWarn);SA1600</NoWarn>
    </PropertyGroup>

    <!--
        Ensure that if anyone adds a local.settings.json, it will get copied to the output folder
        without needing to manually configure it in Solution Explorer. (We don't want to have to
        configure them directly in the .csproj via Solution Explorer  because these local settings
        files don't get checked in, so not everyone has them. So you'd end up with project files
        specifying options for files that aren't actually there, causing Solution Explorer to show
        an entry for the file with a red icon indicating a problem.)

        This is in the .targets file so that it can run after all items have been defined.
    -->
    <ItemGroup>
        <None Update="local.settings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!--
        StyleCop.Analyzers and Roslynator.Analyzers come in as dependencies of this package (see
        the nuspec), so they can't be left out of restore conditionally. Instead, when
        EndjinDisableCodeAnalysis is true, we remove their analyzers after NuGet has resolved
        them. ResolveLockFileAnalyzers also runs in Visual Studio design-time builds, so the
        IDE respects the setting too.
    -->
    <Target Name="_EndjinRemoveCodeAnalysisAnalyzers" AfterTargets="ResolveLockFileAnalyzers" Condition="'$(EndjinDisableCodeAnalysis)' == 'true'">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'StyleCop.Analyzers' Or '%(Analyzer.NuGetPackageId)' == 'Roslynator.Analyzers'" />
        </ItemGroup>
    </Target>

    <!--
        This package and its analyzer dependencies are for building the consuming project only.
        NuGet tooling adds development dependencies with PrivateAssets="all", which stops them
        flowing into packages that the consuming project produces. A hand-written reference
        without it would make the produced package depend on Endjin.RecommendedPractices (and,
        through it, the analyzers), so we fail the pack in that case.
    -->
    <Target Name="_EndjinVerifyPrivateAssets" BeforeTargets="GenerateNuspec">
        <ItemGroup>
            <_EndjinNonPrivateReference
                Include="@(PackageReference)"
                Condition="('%(PackageReference.Identity)' == 'Endjin.RecommendedPractices' Or '%(PackageReference.Identity)' == 'Endjin.RecommendedPractices.GitHub') And '%(PackageReference.PrivateAssets)' != 'all'" />
        </ItemGroup>
        <Error
            Condition="'@(_EndjinNonPrivateReference)' != ''"
            Text="The PackageReference to %(_EndjinNonPrivateReference.Identity) must set PrivateAssets to all, or the package this project produces will depend on it. Change the reference to: &lt;PackageReference Include=&quot;%(_EndjinNonPrivateReference.Identity)&quot; Version=&quot;...&quot; PrivateAssets=&quot;all&quot; /&gt;"
            />
    </Target>
</Project>