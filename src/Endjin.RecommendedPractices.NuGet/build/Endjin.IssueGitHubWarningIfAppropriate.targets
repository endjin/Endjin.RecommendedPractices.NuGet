<!--
    In V1, we always added an implicit reference to the GitHub Source Link components. In V2, the
    GitHub-specific behaviour moved to the Endjin.RecommendedPractices.GitHub package, so that this
    package can be used in projects that are not on GitHub.

    As of V3, Source Link comes from the .NET SDK, whichever of the two packages a project uses.
    What the GitHub package still adds is package metadata from the GitHub repository: the
    repository type, the project URL, and release notes that link to the GitHub releases.

    So this file detects when GitHub is in use. If it is, and if the project is not using
    Endjin.RecommendedPractices.GitHub, then unless the developer has set the
    EndjinDisableGitHubSourceLinkWarning property to true, we issue a warning suggesting they
    change their reference to Endjin.RecommendedPractices.GitHub. (The property name dates from
    V2, when the warning was about Source Link.)

    The work we need to do for this warning produces some outputs that are potentially useful.
    These will be set by the EndjinDetectGitHub task, so consumers of this package that want
    to use these should only do so in tasks that depend on EndjinDetectGitHub.

        EndjinProjectIsInGitRepo        true if the project is in a folder associated with a Git repo
        EndjinProjectIsInGitHubRepo     true if the project is in a Git repo whose remote is on GitHub, otherwise false
        EndjinGitHubUrl                 The URL of the GitHub project
        EndjinGitHubOrg                 The GitHub organization/account name
        EndjinGitHubProject             The GitHub project name
-->

<Project ToolsVersion="14.0"
    xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
    InitialTargets="_EndjinIssueGitHubWarningIfAppropriate">

    <Target Name="EndjinDetectGitHub">
        <PropertyGroup>
            <!--
                Ideally we wouldn't need this hack.
                Having worked out how to use the LocateRepository it became apparent that
                there's no way to prevent it from issuing a warning in the case where there's
                no GitHub repo. Unfortunately, that's exactly the new scenario we're looking
                to support with this file in Endjin.RecommendedPractices v2.
                So we use this rather grotty hack to try to locate the .git folder, and only
                invoke the LocateRepository task (which extracts all the info) if it's there.
            -->
            <_EndjinGitFolderFound Condition="Exists('$(MSBuildProjectDirectory)/.git') Or Exists('$(MSBuildProjectDirectory)/../.git') Or Exists('$(MSBuildProjectDirectory)/../../.git') Or Exists('$(MSBuildProjectDirectory)/../../../.git') Or Exists('$(MSBuildProjectDirectory)/../../../../.git') Or Exists('$(MSBuildProjectDirectory)/../../../../../.git') Or Exists('$(MSBuildProjectDirectory)/../../../../../../.git')">true</_EndjinGitFolderFound>
        </PropertyGroup>

        <!--
            LocateRepository comes from Microsoft.Build.Tasks.Git, which we don't reference as a
            package (see the nuspec). It is registered by the .NET SDK's built-in Source Link
            support, or by a Microsoft.SourceLink.* package if the project references one.
            Either way, MicrosoftBuildTasksGitAssemblyFile is set when the task is available.
            If it isn't (SuppressImplicitGitSourceLink set with no package, or a build that
            doesn't use the .NET SDK), we skip detection rather than fail the build.
        -->
        <Microsoft.Build.Tasks.Git.LocateRepository Condition="'$(_EndjinGitFolderFound)' == 'true' And '$(MicrosoftBuildTasksGitAssemblyFile)' != ''" Path="$(MSBuildProjectDirectory)" RemoteName="$(GitRepositoryRemoteName)" ConfigurationScope="$(GitRepositoryConfigurationScope)">

            <Output TaskParameter="WorkingDirectory" PropertyName="_EndjinWorkingDirectory" />
            <Output TaskParameter="RepositoryId" PropertyName="_EndjinGitRepositoryId" />
            <Output TaskParameter="Url" PropertyName="_EndjinUrl" />
            <!-- <Output TaskParameter="RevisionId" PropertyName="SourceRevisionId" Condition="'$(SourceRevisionId)' == ''" /> -->
        </Microsoft.Build.Tasks.Git.LocateRepository>
        <PropertyGroup>
            <EndjinProjectIsInGitRepo Condition="'$(_EndjinWorkingDirectory)'!=''">true</EndjinProjectIsInGitRepo>
            <EndjinProjectIsInGitRepo Condition="'$(EndjinProjectIsInGitRepo)'==''">false</EndjinProjectIsInGitRepo>
        </PropertyGroup>

        <PropertyGroup Condition="'$(EndjinProjectIsInGitRepo)'=='true'">
            <EndjinProjectIsInGitHubRepo Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($(_EndjinUrl), `(https://|ssh://[^@]*@)github.com/([^/]*)/([^/]*)`))">true</EndjinProjectIsInGitHubRepo>
        </PropertyGroup>
        <PropertyGroup>
            <!-- Not GitHub, or not a Git repo at all. -->
            <EndjinProjectIsInGitHubRepo Condition="'$(EndjinProjectIsInGitHubRepo)'==''">false</EndjinProjectIsInGitHubRepo>
        </PropertyGroup>

        <PropertyGroup Condition="'$(EndjinProjectIsInGitHubRepo)'=='true'">
            <EndjinGitHubUrl>$(_EndjinUrl)</EndjinGitHubUrl>
            <EndjinGitHubOrg>$([System.Text.RegularExpressions.Regex]::Match($(_EndjinUrl), `(https://|ssh://[^@]*@)github.com/([^/]*)/([^/]*)`).Groups[2].Value)</EndjinGitHubOrg>
            <EndjinGitHubProject>$([System.Text.RegularExpressions.Regex]::Match($(_EndjinUrl), `(https://|ssh://[^@]*@)github.com/([^/]*)/([^/]*)(\.git)?`).Groups[3].Value)</EndjinGitHubProject>
            <EndjinGitHubProject Condition="$(EndjinGitHubProject.EndsWith('.git'))">$(EndjinGitHubProject.Substring(0, $(EndjinGitHubProject.LastIndexOf('.'))))</EndjinGitHubProject>
        </PropertyGroup>
    </Target>

    <Target Name="_EndjinIssueGitHubWarningIfAppropriate" DependsOnTargets="EndjinDetectGitHub">

        <!--
            A warning, not an error: the build output is correct without the GitHub package, it just
            has less package metadata. (TreatWarningsAsErrors applies to compiler warnings, not to
            warnings from MSBuild tasks like this one, so it doesn't turn this into an error.)
        -->
        <Warning
            Condition=" ('$(EndjinProjectIsInGitHubRepo)' == 'true') And ('$(_EndjinGitHubPackageImported)' != 'true') And ($(EndjinDisableGitHubSourceLinkWarning) != 'true') "
            Text="This project is in a GitHub repository, but it references Endjin.RecommendedPractices instead of Endjin.RecommendedPractices.GitHub. Change the reference to Endjin.RecommendedPractices.GitHub to set the package's project URL, repository type and release notes from the GitHub repository. (Source Link works with either package, because it comes from the .NET SDK.) To hide this warning, set the EndjinDisableGitHubSourceLinkWarning build property to true."
            />
    </Target>
</Project>