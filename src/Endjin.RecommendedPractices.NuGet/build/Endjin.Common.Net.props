<!--
    Sets properties common to all .NET projects using endjin's conventions
-->

<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    We presume that a solution exists. One of the important jobs we do is creating a
    default .editorconfig file if none exists. This is a solution-level item.
    Building in Visual Studio this isn't a problem because that always builds the solution.
    However, with the .NET CLI it's often not the case. And it seems that developing in
    VS code also throws up issues, possibly because it's using the CLI too, or working in
    a way similar to how the CLI does.
    So we need to detect when the build system hasn't provided the solution directory and
    set the property ourselves.
  -->
  <PropertyGroup Condition="$(SolutionDir) == ''">
    <SolutionDir>$([System.IO.Path]::GetDirectoryName($(MSBuildProjectDirectory)))\</SolutionDir>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The SDK's targets files will include the processor architecture in the output folder path
      (e.g., bin\Release\x64) for anything other than the AnyCPU architecture.
      Unfortunately, when VSTS uses MSTest to run XUnit tests, it ends up looking in the wrong
      place for the test adapter. Even if a project contains no tests, MSTest/XUnit will
      still go looking for them, producing errors in the Test section of the Output window.
      So we force the output location to avoid this.

      A related issue is that the .NET Core-style SDK (MSBuild 15) build seems to want to include the
      target framework name (e.g. bin\Release\net462).

      All of this makes it somewhat tricky to set variables that need to point directly into
      the output path. Most notably, the <DocumentationFile> attribute has proven problematic:
      if you don't explicitly set the OutputPath variable yourself, there's no relible way to
      specify "Always generated XML doc, and always put it in the build output folder, wherever
      that might be".

      Finally, the comments in Microsoft.Common.CurrentVersion.targets state that the build
      tooling does actually expect you to set this stuff yourself, and only picks values for
      you as a courtesy.

      So for all these reasons, we're specifying our own OutputPath. This enables us to fix
      the XUnit test runner problem, and it also means it's safe for any of our project files
      to refer the $(OutputPath).
    -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!--
        With .NET Core 3 or later, the latest language is the default, but for older versions you have to ask for it
    -->
    <LangVersion>latest</LangVersion>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Warnings are errors in Release builds only. That still stops code with warnings from being
    merged, because CI and packaging build Release (dotnet pack and dotnet publish default to
    Release), but it lets developers experiment in Debug builds without first having to satisfy
    every analyzer.

    Configuration is only known here when it is passed in (dotnet build -c Release, Visual Studio,
    dotnet pack): the .NET SDK sets its Debug default after this file. When it's Release, we set
    TreatWarningsAsErrors to true here, so that anything derived from it early in the build sees
    the final value.

    Otherwise we set it to "False", with a capital F. MSBuild treats that as false like any other
    spelling, and it stops the .NET SDK's own default (false, which Microsoft.NET.Sdk.props sets
    after this file) from applying. A project can still choose its configuration in its own file,
    after this. So Endjin.Common.Net.targets, which runs once the final configuration is known,
    changes exactly "False" to true in Release builds. A value the project sets itself, such as
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>, is spelled differently, so it's kept.

    A project (or Directory.Build.props) that sets TreatWarningsAsErrors itself keeps its value,
    so you can make warnings errors in every configuration with:

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  -->
  <PropertyGroup Condition="'$(TreatWarningsAsErrors)' == ''">
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(Configuration)' != 'Release'">False</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <TreatSpecificWarningsAsErrors />
    <WarningsAsErrors />

  </PropertyGroup>

  <PropertyGroup>
    <DebugType>portable</DebugType>
    <ci>true</ci>
  </PropertyGroup>

  <ItemGroup Condition="($(EndjinDisableCodeAnalysis) != 'true') and (Exists('$(SolutionDir)stylecop.json'))">
    <AdditionalFiles Include="$(SolutionDir)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <!--
    On the first build of a clean checkout, the solution-level stylecop.json doesn't exist yet
    when the project is evaluated: Endjin.Common.Net.targets only copies it into place during
    the build. Without settings, StyleCop falls back to its defaults (e.g. the company name
    "PlaceholderCompany"), so rules such as SA1636 fail every file header. So until the
    solution has its own copy, we give StyleCop the package's copy, which has the same contents.
  -->
  <ItemGroup Condition="($(EndjinDisableCodeAnalysis) != 'true') and (!Exists('$(SolutionDir)stylecop.json'))">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <!--
    The same first-build problem applies to .editorconfig, and a fallback copy can't fix it: an
    .editorconfig only applies to files in or below its own folder. So the C# settings from the
    default .editorconfig are also supplied as a global analyzer config, which applies to every
    file in the compilation. Any .editorconfig (including the copied one) overrides it, so it only
    makes a difference until the solution has its own .editorconfig. See the file for details.
    Setting EndjinDisableCreateEditorConfig to true turns off both.
  -->
  <ItemGroup Condition="$(EndjinDisableCreateEditorConfig) != 'true'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)Endjin.CodeAnalysis.globalconfig" />
  </ItemGroup>

</Project>